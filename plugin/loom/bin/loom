#!/usr/bin/env python3
"""loom: the command line Claude Code chats use to talk to Loom. Needs python3 (3.9+), nothing else.

  loom outbox add --thread <url> | --channel <id|#name|@user>  --text-file <p> [--file <img> ...] [--text-file <p> ...]
                                                     --file attaches an image to the message it follows;
                                                     --images-only starts a message with no text
  loom outbox add --review-file <review.json> [--reactions-file <rx.json>] [--thread <url> --text-file <p> ...]
                                                     a GitHub PR review (posted first on Send, all comments in
                                                     one call), optionally with the Slack reply and reactions
  loom outbox add --email-file <email.json>          an email, sent through the email CLI on Send
                                                     ({to, cc?, bcc?, subject, body, account?, from?, threadId?,
                                                     inReplyTo?, references?, thread_subject?, signature?, attachments?})
                    [--seen <ts|json>]               what the chat last saw in the target (a Slack ts, or
                                                     {"slack":ts,"email":id,"github":{"at":iso,"id":id}}); Send warns
                                                     when anything newer from someone else has landed. Without it Loom
                                                     records what is there when the draft arrives.
  loom outbox update <id> --text-file <p> [--file <img> ...] [...]   revise a pending draft in place
                                                     (--clear-files drops attachments; omit --file to keep them;
                                                     --review-file / --reactions-file / --email-file replace those parts)
  loom outbox supersede <id>                         retire a pending draft a newer one replaces
  loom outbox list [--json] [--all] | show <id>
  loom thread claim <url> | started <url|key> | release <url> | list [filter]
  loom thread open <url> [--ack] [--eyes]            mark a ticket looking (eyes only on a channel's top-level post)
  loom thread stage <url> looking|blocked|done [note...] [--react]
  loom ship-label "<label>" [--repo <path>] | --show | --clear
  loom ship-lock acquire | release | status | wait [repo]   (<repo>'s git common dir, default the cwd's; no Loom needed)
  loom route list | send <name> <text...>
  loom test-links add <url> [--label "<what to check>"] | list [--json] | clear [<url>]
  loom trees prune [--repo <dir>] [--dry-run] [--json]   remove worktrees that are merged, clean and unused
  loom whoami

Writes are atomic event files in $LOOM_HOME/events/, so they survive Loom being down. Reads and Slack
actions go over HTTP to 127.0.0.1 with the CLI token. The Slack token never reaches this process.
The session is $CLAUDE_CODE_SESSION_ID (override with --session on outbox add).
"""
import json
import os
import random
import re
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "hooks"))
import _common as c  # noqa: E402

STAGES = {
    "looking": "eyes",
    "blocked": "no_entry",
    "done": "white_check_mark",
}
SUPERSEDES = dict((k, [e for j, e in STAGES.items() if j != k]) for k in STAGES)
ACKS = [
    "Checking this out now",
    "Let me have a look",
    "Looking into it",
    "Taking a look",
    "Looking into this now",
    "I'll take a look",
    "Let me dig into this",
    "Let me check on this",
    "On it, taking a look now",
    "Having a look now",
]
LABEL_MAX = 80
TTL_SECONDS = 300


def die(msg, code=1):
    print("loom: " + msg, file=sys.stderr)
    sys.exit(code)


def opts(args, multi=(), flags=()):
    """--flag value pairs; names in `multi` repeat into a list, names in `flags` take no value."""
    out, rest, i = {}, [], 0
    while i < len(args):
        a = args[i]
        if a.startswith("--"):
            key = a[2:].replace("-", "_")
            if key in flags or i + 1 >= len(args) or args[i + 1].startswith("--"):
                val, i = True, i + 1
            else:
                val, i = args[i + 1], i + 2
            if key in multi:
                out.setdefault(key, []).append(val)
            else:
                out[key] = val
        else:
            rest.append(a)
            i += 1
    return out, rest


def need_session(o=None):
    sid = (o or {}).get("session") or c.session_id()
    if not sid:
        die("no session id: run inside a Claude session (CLAUDE_CODE_SESSION_ID)", 2)
    return sid


def get(path):
    try:
        return c.http("GET", path)
    except c.LoomUnavailable as e:
        die("Loom is not reachable (%s). Is it running?" % e, 3)
    except c.LoomError as e:
        die(str(e), 4)


def to_key(arg):
    keys = c.thread_keys(arg)
    if not keys and re.fullmatch(r"[A-Z0-9]+/\d{10}\.\d{6}", arg or ""):
        keys = {arg: url_for_key(arg, {})}
    if not keys:
        die("not a Slack thread URL", 2)
    return keys


def url_for_key(key, urls):
    if urls.get(key) and urls[key] != key:
        return urls[key]
    channel, ts = key.split("/")
    return "https://app.slack.com/archives/%s/p%s" % (channel, ts.replace(".", ""))


# ---------- outbox ----------

def read_messages(files):
    out = []
    for p in files:
        try:
            with open(p) as f:
                text = f.read().strip()
        except OSError as e:
            die("cannot read %s: %s" % (p, e), 2)
        if not text:
            die("%s is empty" % p, 2)
        out.append(text)
    return out


def message_specs(args, cmd):
    """Walk the args in order: --text-file / --images-only start a message, --file attaches to the latest one.
    Returns (paths, files): the text file per message (None = images only) and the absolute attachments per message."""
    paths, files, i = [], [], 0
    while i < len(args):
        a = args[i]
        if a == "--text-file" and i + 1 < len(args):
            paths.append(args[i + 1])
            files.append([])
            i += 2
        elif a == "--images-only":
            paths.append(None)
            files.append([])
            i += 1
        elif a == "--file":
            if i + 1 >= len(args) or args[i + 1].startswith("--"):
                die("%s: --file needs a path" % cmd, 2)
            if not paths:
                die("%s: --file must come after the --text-file (or --images-only) it belongs to" % cmd, 2)
            p = os.path.abspath(os.path.expanduser(args[i + 1]))
            if not os.path.isfile(p):
                die("%s: file not found: %s" % (cmd, p), 2)
            files[-1].append(p)
            i += 2
        else:
            i += 1
    for p, f in zip(paths, files):
        if p is None and not f:
            die("%s: --images-only needs at least one --file after it" % cmd, 2)
    return paths, files


def messages_and_files(paths, files):
    texts = read_messages([p for p in paths if p is not None])
    it = iter(texts)
    return [next(it) if p is not None else "" for p in paths], files


REVIEW_EVENTS = ("COMMENT", "REQUEST_CHANGES", "APPROVE")
SLACK_LINK = re.compile(r"/archives/([CGD][A-Z0-9]+)/p(\d{10})(\d{6})")


def read_json(path, cmd, what):
    try:
        with open(path) as f:
            return json.load(f)
    except OSError as e:
        die("%s: cannot read %s: %s" % (cmd, path, e), 2)
    except ValueError as e:
        die("%s: %s is not JSON (%s): %s" % (cmd, what, path, e), 2)


def check_review(r, cmd):
    """The same rules Loom applies (src/outboxreview.ts cleanReview), so a bad file fails here, not silently later."""
    bad = lambda m: die("%s: review: %s" % (cmd, m), 2)
    if not isinstance(r, dict):
        bad("the file must hold one JSON object")
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", str(r.get("repo") or "")):
        bad("repo must be owner/name")
    if not (isinstance(r.get("pr"), int) and r["pr"] > 0) and not re.fullmatch(r"\d+", str(r.get("pr") or "")):
        bad("pr must be a PR number")
    r["pr"] = int(r["pr"])
    if not re.fullmatch(r"[0-9a-fA-F]{7,40}", str(r.get("commit_id") or "")):
        bad("commit_id must be the PR head sha the review was written against")
    ev = str(r.get("event") or "").upper()
    if ev not in REVIEW_EVENTS:
        bad("event must be one of " + ", ".join(REVIEW_EVENTS))
    r["event"] = ev
    if ev != "APPROVE" and not str(r.get("body") or "").strip():
        bad("body is required for " + ev)
    comments = r.get("comments") or []
    if not isinstance(comments, list):
        bad("comments must be a list")
    for i, c in enumerate(comments):
        if not isinstance(c, dict) or not str(c.get("path") or "").strip():
            bad("comments[%d] needs a path" % i)
        if not isinstance(c.get("line"), int) or c["line"] <= 0:
            bad("comments[%d] needs a line (a positive number)" % i)
        if not str(c.get("body") or "").strip():
            bad("comments[%d] needs a body" % i)
        if c.get("side") not in (None, "RIGHT", "LEFT"):
            bad("comments[%d].side must be RIGHT or LEFT" % i)
    r["comments"] = comments
    return r


def check_reactions(rx, cmd):
    """[{channel, ts} or {url}, add: [emoji], remove: [emoji]}]: a message link gives channel and ts."""
    bad = lambda m: die("%s: reactions: %s" % (cmd, m), 2)
    if not isinstance(rx, list):
        bad("the file must hold a JSON list")
    out = []
    for i, r in enumerate(rx):
        if not isinstance(r, dict):
            bad("[%d] must be an object" % i)
        channel, ts = r.get("channel"), r.get("ts")
        if r.get("url") and not (channel and ts):
            m = SLACK_LINK.search(str(r["url"]))
            if not m:
                bad("[%d].url is not a Slack message link" % i)
            channel, ts = m.group(1), "%s.%s" % (m.group(2), m.group(3))
        if not re.fullmatch(r"[CGD][A-Z0-9]{6,}", str(channel or "")) or not re.fullmatch(r"\d{10}\.\d{6}", str(ts or "")):
            bad("[%d] needs channel + ts (or a message url)" % i)
        names = lambda k: [str(e).strip(":") for e in (r.get(k) or [])]
        add, remove = names("add"), names("remove")
        if not add and not remove:
            bad("[%d] adds and removes nothing" % i)
        e = {"channel": channel, "ts": ts}
        if add:
            e["add"] = add
        if remove:
            e["remove"] = remove
        out.append(e)
    return out


def pr_facts(r):
    """Title and url for the card, from the person's own gh (read-only). Warns when the head already moved."""
    if os.environ.get("LOOM_NO_GH") == "1" or (r.get("title") and r.get("url")):
        return
    try:
        p = subprocess.run(["gh", "pr", "view", str(r["pr"]), "--repo", r["repo"], "--json", "title,url,headRefOid"],
                           capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return
    if p.returncode != 0:
        return
    try:
        j = json.loads(p.stdout)
    except ValueError:
        return
    r.setdefault("title", j.get("title") or "")
    r.setdefault("url", j.get("url") or "")
    head = str(j.get("headRefOid") or "")
    if head and not head.lower().startswith(str(r["commit_id"]).lower()):
        print("outbox: the PR head is %s, not the review's commit_id %s; the card will warn before posting"
              % (head[:7], str(r["commit_id"])[:7]), file=sys.stderr)


ADDR = re.compile(r"[^\s@<>,;]+@[^\s@<>,;]+\.[^\s@<>,;]+")


def addr_ok(a):
    m = re.search(r"<([^<>]+)>", a)
    return bool(ADDR.fullmatch((m.group(1) if m else a).strip()))


def check_email(e, cmd):
    """The same rules Loom applies (src/outboxemail.ts cleanEmail), so a bad file fails here, not on Send."""
    bad = lambda m: die("%s: email: %s" % (cmd, m), 2)
    if not isinstance(e, dict):
        bad("the file must hold one JSON object")
    e.pop("kind", None)
    for k in ("to", "cc", "bcc"):
        v = e.get(k)
        if v is None or v == "":
            e.pop(k, None)
            continue
        if isinstance(v, str):
            v = [x.strip() for x in v.split(",") if x.strip()]
        if not isinstance(v, list) or not all(isinstance(x, str) for x in v):
            bad("%s must be a list of addresses" % k)
        for a in v:
            if not addr_ok(a):
                bad("not an email address: %s" % a)
        e[k] = v
    if not e.get("to"):
        bad("needs at least one recipient in to")
    if not str(e.get("subject") or "").strip():
        bad("subject is required")
    if not str(e.get("body") or "").strip():
        bad("body is required")
    if bool(e.get("threadId")) != bool(e.get("inReplyTo")):
        bad("a reply needs both threadId and inReplyTo (the Message-ID it answers, from `gmail read`)")
    if e.get("inReplyTo") and not re.fullmatch(r"<[^<>\s]+>", str(e["inReplyTo"])):
        bad("inReplyTo must be a Message-ID like <abc@mail.example.com>")
    atts = []
    for a in e.get("attachments") or []:
        p = os.path.abspath(os.path.expanduser(str(a)))
        if not os.path.isfile(p):
            bad("attachment not found: %s" % p)
        atts.append(p)
    if atts:
        e["attachments"] = atts
    else:
        e.pop("attachments", None)
    return e


def parse_seen(v, cmd):
    if v is None or v is True:
        return None
    if re.fullmatch(r"\d{10}\.\d{6}", v):
        return {"slack": v}
    try:
        j = json.loads(v)
    except ValueError:
        die("%s: --seen takes a Slack ts or a JSON object" % cmd, 2)
    if not isinstance(j, dict):
        die("%s: --seen takes a Slack ts or a JSON object" % cmd, 2)
    return j


def review_parts(o, cmd):
    ev = {}
    if o.get("review_file"):
        ev["review"] = check_review(read_json(o["review_file"], cmd, "--review-file"), cmd)
        pr_facts(ev["review"])
    if o.get("reactions_file"):
        ev["reactions"] = check_reactions(read_json(o["reactions_file"], cmd, "--reactions-file"), cmd)
    if o.get("email_file"):
        if ev or o.get("thread") or o.get("channel"):
            die("%s: an email draft cannot also carry Slack messages or a review" % cmd, 2)
        ev["email"] = check_email(read_json(o["email_file"], cmd, "--email-file"), cmd)
    return ev


def outbox_add(args):
    o, _ = opts(args, multi=("text_file",), flags=("images_only",))
    sid = need_session(o)
    paths, files = message_specs(args, "outbox add")
    parts = review_parts(o, "outbox add")
    seen = parse_seen(o.get("seen"), "outbox add")
    if "email" in parts:
        if paths:
            die("outbox add: an email draft has no --text-file; the body is in the email file", 2)
        ev = {"session": sid, "messages": [], "channel": "", "email": parts["email"]}
        if seen:
            ev["seen"] = seen
        ev["id"] = "d%x" % int(time.time() * 1000) + "%02x" % random.randrange(256)
        c.write_event("outbox.add", **ev)
        print(ev["id"])
        return
    if o.get("thread") and o.get("channel"):
        die("outbox add: give one of --thread <url> or --channel <id>, not both", 2)
    if "review" not in parts:
        if not (o.get("thread") or o.get("channel")):
            die("outbox add: exactly one of --thread <url> or --channel <id> is required", 2)
        if not paths:
            die("outbox add: --text-file <path> is required", 2)
    elif paths and not (o.get("thread") or o.get("channel")):
        die("outbox add: Slack messages need --thread <url> or --channel <id>", 2)
    msgs, files = messages_and_files(paths, files)
    ev = {"session": sid, "messages": msgs}
    ev.update(parts)
    if seen:
        ev["seen"] = seen
    if any(files):
        ev["files"] = files
    if not paths:
        ev["channel"] = ""
    elif o.get("thread"):
        keys = c.thread_keys(o["thread"])
        if not keys:
            die("outbox add: --thread is not a Slack thread URL", 2)
        key, url = next(iter(keys.items()))
        ev["channel"], ev["thread_ts"] = key.split("/")
        ev["thread_url"] = url
    else:
        ev["channel"] = o["channel"]
        try:
            mine = [t for t in (c.http("GET", "/api/cli/threads?session=" + sid, timeout=1.5).get("threads") or [])
                    if str(t.get("key", "")).startswith(str(o["channel"]) + "/")]
            if mine:
                print("outbox add: this chat owns thread %s in %s. If this is a reply, re-record it with "
                      "--thread <url> so Loom can watch for the answer." % (mine[0]["key"], o["channel"]),
                      file=sys.stderr)
        except (c.LoomUnavailable, c.LoomError):
            pass
    n = int(time.time() * 1000)
    ev["id"] = "d%x" % n + "%02x" % random.randrange(256)
    # Loom supersedes this session's pending draft for the same destination when it ingests this.
    c.write_event("outbox.add", **ev)
    print(ev["id"])


def outbox_update(args):
    o, rest = opts(args, multi=("text_file",), flags=("images_only", "clear_files"))
    paths, files = message_specs(args, "outbox update")
    parts = review_parts(o, "outbox update")
    if not rest or not (paths or parts):
        die("usage: loom outbox update <id> --text-file <path> [--file <img> ...] [...] | --review-file <json> | --reactions-file <json> | --email-file <json>", 2)
    if "email" in parts and paths:
        die("outbox update: an email draft has no --text-file; the body is in the email file", 2)
    ev = dict(parts)
    if paths:
        msgs, files = messages_and_files(paths, files)
        ev["messages"] = msgs
        if any(files) or o.get("clear_files"):
            ev["files"] = files
    c.write_event("outbox.update", session=c.session_id(), id=rest[0], **ev)
    print(rest[0])


def outbox_supersede(args):
    _, rest = opts(args)
    if not rest:
        die("usage: loom outbox supersede <id>", 2)
    c.write_event("outbox.supersede", session=c.session_id(), id=rest[0])
    print(rest[0])


def outbox_list(args):
    o, _ = opts(args, flags=("json", "all"))
    r = get("/api/cli/outbox" + ("?all=1" if o.get("all") else ""))
    drafts = r.get("drafts") or []
    if o.get("json"):
        print(json.dumps(drafts, indent=2))
        return
    for d in drafts:
        dest = d.get("channel", "") + (" thread " + d["thread_ts"] if d.get("thread_ts") else "")
        first = (d.get("messages") or [""])[0].replace("\n", " ")
        em = d.get("email")
        if em:
            dest = "email to %s%s" % (", ".join(em.get("to") or []), " (reply)" if em.get("threadId") else "")
            first = str(em.get("subject") or "")
        rv = d.get("review")
        if rv:
            tag = "[%s %s#%s%s]" % (rv.get("event"), rv.get("repo"), rv.get("pr"), " posted" if d.get("review_posted") else "")
            dest = (dest + " " + tag).strip()
        print("%s  %-10s %s  %-36s  %s" % (d.get("id"), d.get("status"), str(d.get("session_id", ""))[:8], dest, first[:70]))
    if not drafts:
        print("no drafts")


def outbox_show(args):
    _, rest = opts(args)
    if not rest:
        die("usage: loom outbox show <id>", 2)
    r = get("/api/cli/outbox/" + rest[0])
    print(json.dumps(r.get("draft") or r, indent=2))


def cmd_outbox(args):
    subs = {"add": outbox_add, "update": outbox_update, "supersede": outbox_supersede,
            "list": outbox_list, "show": outbox_show}
    if not args or args[0] not in subs:
        die("usage: loom outbox add|update|supersede|list|show", 2)
    subs[args[0]](args[1:])


# ---------- threads ----------

def thread_state(key):
    try:
        r = c.http("GET", "/api/cli/threads?key=" + key.replace("/", "%2F"), timeout=2.0)
    except (c.LoomUnavailable, c.LoomError):
        return {}
    ts = r.get("threads") or []
    return ts[0] if ts else {}


def slack_direct():
    return c.read_plugin_state().get("slack_mode") == "direct"


def slack_post(path, body):
    """POST a Slack action through Loom. Returns True on success; failures are reported, never fatal."""
    try:
        c.http("POST", path, body, timeout=8.0)
        return True
    except c.LoomError as e:
        if e.status == 409:
            print("loom: Slack is not connected in direct mode; skipped", file=sys.stderr)
        else:
            print("loom: Slack action failed: %s" % e, file=sys.stderr)
    except c.LoomUnavailable as e:
        print("loom: Loom is not reachable, Slack action skipped (%s)" % e, file=sys.stderr)
    return False


def advance(key, url, stage, note=None, react=True):
    c.write_event("thread.stage", session=c.session_id(), key=key, url=url, stage=stage, note=note, react=bool(react))
    shown = False
    if react and slack_direct():
        channel, ts = key.split("/")
        shown = slack_post("/api/cli/slack/react",
                           {"channel": channel, "ts": ts, "add": STAGES[stage], "remove": SUPERSEDES[stage]})
    return shown


def thread_claim(args):
    sid = need_session()
    for key, url in to_key(args[0] if args else "").items():
        prev = thread_state(key).get("session_id")
        c.write_event("thread.claim", session=sid, key=key, url=url, cwd=os.getcwd(), mode="force")
        print("%s -> %s%s" % (url, sid, " (was %s)" % prev if prev and prev != sid else ""))


def thread_started(args):
    sid = need_session()
    claimed = []
    for key, url in to_key(args[0] if args else "").items():
        if key.startswith("D"):
            continue
        c.write_event("thread.claim", session=sid, key=key, url=url, cwd=os.getcwd(),
                      mode="if_unowned", started=True)
        claimed.append(key)
    print(" ".join(claimed) if claimed else "nothing to claim")


def thread_release(args):
    for key in to_key(args[0] if args else ""):
        c.write_event("thread.release", session=c.session_id(), key=key)
        print("released " + key)


def thread_list(args):
    r = get("/api/cli/threads")
    filt = (args[0] if args else "").lower()
    n = 0
    for t in r.get("threads") or []:
        line = "%s  %-8s %s  %s" % (t.get("key"), t.get("stage") or "-", str(t.get("session_id", ""))[:8], t.get("url", ""))
        if not filt or filt in line.lower():
            print(line)
            n += 1
    if not n:
        print("no threads")


def thread_open(args):
    o, rest = opts(args, flags=("ack", "eyes"))
    if not rest:
        die("usage: loom thread open <url> [--ack] [--eyes]", 2)
    keys = to_key(rest[0])
    tops = c.top_level_keys(rest[0])
    for key, url in keys.items():
        # Eyes only on a channel's top-level post, unless forced. A DM or reply link is still
        # recorded as looking, just not shown.
        eyes = bool(o.get("eyes")) or key in tops
        shown = advance(key, url, "looking", react=eyes)
        print("%s -> looking%s" % (key, " :eyes:" if shown else " (no reaction)"))
        if not o.get("ack"):
            continue
        t = thread_state(key)
        if t.get("ack"):
            print("already acked: %r" % (t["ack"].get("text") if isinstance(t["ack"], dict) else t["ack"],))
            continue
        if not slack_direct():
            print("loom: ack skipped: Slack is not connected in direct mode", file=sys.stderr)
            continue
        recent = t.get("recent_acks") or []
        pool = [a for a in ACKS if a not in recent[-6:]] or ACKS
        text = random.choice(pool)
        channel, ts = key.split("/")
        if slack_post("/api/cli/slack/reply", {"channel": channel, "thread_ts": ts, "text": text, "ack": True}):
            c.write_event("thread.ack", session=c.session_id(), key=key, text=text)
            print("acked: %r" % text)


def thread_stage(args):
    o, rest = opts(args, flags=("react",))
    if len(rest) < 2 or rest[1] not in STAGES:
        die("usage: loom thread stage <url> looking|blocked|done [note...] [--react]", 2)
    stage, note = rest[1], " ".join(rest[2:]) or None
    tops = c.top_level_keys(rest[0])
    for key, url in to_key(rest[0]).items():
        react = True
        if stage == "done" and not o.get("react"):
            # The check mark follows the eyes: shown where `open` showed them, else where the link was top-level.
            remembered = thread_state(key).get("react")
            react = remembered if remembered is not None else key in tops
        shown = advance(key, url, stage, note, react=react)
        print("%s -> %s%s" % (key, stage, " :%s:" % STAGES[stage] if shown else " (no reaction)"))


def cmd_thread(args):
    subs = {"claim": thread_claim, "started": thread_started, "release": thread_release,
            "list": thread_list, "open": thread_open, "stage": thread_stage}
    if not args or args[0] not in subs:
        die("usage: loom thread claim|started|release|list|open|stage", 2)
    subs[args[0]](args[1:])


# ---------- ship label ----------

def toplevel(cwd):
    try:
        r = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    except OSError:
        return ""
    return r.stdout.strip() if r.returncode == 0 else ""


def cmd_ship_label(args):
    sid = need_session()
    repo, mode, words, i = None, "set", [], 0
    while i < len(args):
        a = args[i]
        if a == "--repo" and i + 1 < len(args):
            repo, i = args[i + 1], i + 1
        elif a in ("--show", "--clear"):
            mode = a[2:]
        elif a in ("-h", "--help"):
            print(__doc__)
            return
        else:
            words.append(a)
        i += 1
    if mode == "show":
        entry = c.ship_labels(sid).get(sid)
        if not entry or not entry.get("label"):
            sys.exit(1)
        print(entry["label"])
        return
    if mode == "clear":
        c.write_event("ship.label", session=sid, clear=True)
        return
    one = " ".join(" ".join(words).split())
    label = one if len(one) <= LABEL_MAX else one[: LABEL_MAX - 1].rstrip() + "…"
    if not label:
        die('usage: loom ship-label "<label>" [--repo <path>] | --show | --clear', 2)
    root = toplevel(os.path.expanduser(repo) if repo else os.getcwd())
    if not root:
        root = os.path.abspath(os.path.expanduser(repo)) if repo else os.getcwd()
    c.write_event("ship.label", session=sid, label=label, repo=root)
    print("ship-label: " + label)


# ---------- ship lock ----------

def lock_repo(repo=None):
    """(primary checkout root, lock file) for `repo` (default: the cwd). One lock per repo, shared by its worktrees."""
    cwd = os.path.expanduser(repo) if repo else None
    r = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True, text=True, cwd=cwd)
    if r.returncode != 0 or not r.stdout.strip():
        die("ship-lock: not inside a git repository" + (" (%s)" % repo if repo else ""), 2)
    common = r.stdout.strip()
    root = os.path.dirname(common) if os.path.basename(common) == ".git" else common
    return os.path.realpath(root), os.path.join(common, "ship.lock")


def lock_path(repo=None):
    return lock_repo(repo)[1]


def lock_off(root):
    """True when Loom has this repo on Ship with its ship lock switched off (Settings > Ship)."""
    ship = c.read_plugin_state().get("ship") or {}
    repos = [os.path.realpath(x) for x in ship.get("repos") or []]
    lock = [os.path.realpath(x) for x in ship.get("lock") or []]
    return root in repos and root not in lock


def read_lock(path):
    try:
        with open(path) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else None
    except (OSError, ValueError):
        return None


def pane_phrase(d):
    return " in tmux pane %s" % d["tmux_pane"] if d.get("tmux_pane") else ""


def cmd_ship_lock(args):
    sub = args[0] if args else "status"
    root, path = lock_repo(args[1] if len(args) > 1 else None)
    me = os.environ.get("AGENT_SESSION_ID") or c.session_id() or os.environ.get("CODEX_THREAD_ID") or "unknown"
    cur = read_lock(path)

    def age(d):
        return int(time.time()) - int(d.get("acquired_at") or 0) if d else 999999

    def stale(d):
        return age(d) > TTL_SECONDS

    if sub == "acquire" and lock_off(root):
        print("ship-lock: off for %s in Loom (Settings > Ship); not acquiring" % root)
        return
    if sub == "acquire":
        if cur and cur.get("session_id") != me and not stale(cur):
            print("ship-lock: held by another session (%s%s, %ds ago); not acquiring"
                  % (cur.get("session_id"), pane_phrase(cur), age(cur)), file=sys.stderr)
            sys.exit(1)
        pane = ""
        if os.environ.get("TMUX_PANE"):
            r = subprocess.run(["tmux", "display-message", "-p", "-t", os.environ["TMUX_PANE"],
                                "#{session_name}:#{window_index}.#{pane_index}"], capture_output=True, text=True)
            pane = r.stdout.strip() if r.returncode == 0 else ""
        tmp = path + ".%d.tmp" % os.getpid()
        with open(tmp, "w") as f:
            json.dump({"session_id": me, "acquired_at": int(time.time()), "tmux_pane": pane}, f)
        os.replace(tmp, path)
        print("ship-lock: acquired by " + me)
    elif sub == "release":
        # Only the holder (or anyone, once stale) may release; releasing someone else's live lock is the bug this prevents.
        if cur and cur.get("session_id") != me and not stale(cur):
            print("ship-lock: held by another session (%s); not releasing" % cur.get("session_id"), file=sys.stderr)
            sys.exit(1)
        try:
            os.remove(path)
        except OSError:
            pass
        print("ship-lock: released")
    elif sub == "wait":
        while True:
            cur = read_lock(path)
            if not cur or cur.get("session_id") == me or stale(cur):
                break
            time.sleep(5)
        print("ship-lock: clear; retry git add")
    elif sub == "status":
        if cur:
            print("ship-lock: held by %s%s, %ds ago%s" % (cur.get("session_id"), pane_phrase(cur), age(cur),
                                                         " (stale)" if stale(cur) else ""))
        else:
            print("ship-lock: unlocked")
    else:
        die("usage: loom ship-lock acquire | release | status | wait [repo]", 2)


# ---------- test links ----------

TEST_LINKS_MAX = 10


def cmd_test_links(args):
    sub = args[0] if args else ""
    o, rest = opts(args[1:], flags=("json",))
    sid = need_session(o)
    if sub == "add":
        if len(rest) != 1:
            die('usage: loom test-links add <url> [--label "<what to check>"]', 2)
        url = rest[0].strip()
        if not re.match(r"https?://[^\s/]+", url, re.I) or len(url) > 2000:
            die("test-links add: only http(s) URLs are allowed", 2)
        label = o.get("label")
        c.write_event("testlinks.add", session=sid, url=url, label=label if isinstance(label, str) else "")
        print("test link recorded (newest %d kept per chat)" % TEST_LINKS_MAX)
    elif sub == "list":
        r = get("/api/cli/test-links?session=" + sid)
        links = r.get("links") or []
        if o.get("json"):
            print(json.dumps(links, indent=2))
            return
        for l in links:
            print("%s  %s" % (l.get("url"), l.get("label") or ""))
        if not links:
            print("no test links")
    elif sub == "clear":
        if len(rest) > 1:
            die("usage: loom test-links clear [<url>]", 2)
        c.write_event("testlinks.clear", session=sid, **({"url": rest[0]} if rest else {}))
        print("cleared" if not rest else "cleared " + rest[0])
    else:
        die("usage: loom test-links add <url> [--label ...] | list | clear [<url>]", 2)


# ---------- trees ----------

PRUNE_TIMEOUT = 600.0


def cmd_trees(args):
    sub = args[0] if args else ""
    if sub != "prune":
        die("usage: loom trees prune [--repo <dir>] [--dry-run] [--json]", 2)
    o, rest = opts(args[1:], flags=("dry_run", "json"))
    if rest or o.get("repo") is True:
        die("usage: loom trees prune [--repo <dir>] [--dry-run] [--json]", 2)
    repo = os.path.abspath(os.path.expanduser(o.get("repo") or os.getcwd()))
    dry = bool(o.get("dry_run"))
    try:
        r = c.http("POST", "/api/cli/trees/prune", {"repo": repo, "dry_run": dry}, timeout=PRUNE_TIMEOUT)
    except c.LoomUnavailable as e:
        die("Loom is not reachable (%s). Is it running?" % e, 3)
    except c.LoomError as e:
        die(str(e), 4)
    results = r.get("results") or []
    if o.get("json"):
        print(json.dumps(results, indent=2))
        return
    failed = False
    for res in results:
        if res.get("error"):
            failed = True
            print("%s: %s" % (res.get("repo"), res.get("error")))
            continue
        verb = "would remove" if dry else "removed"
        for w in res.get("removed") or []:
            branch = "branch deleted" if w.get("branchDeleted") else (w.get("branchNote") or "branch kept")
            print("%s  %s  [%s, %s]  %s" % (verb, w.get("path"), w.get("branch"), w.get("merge"), branch))
        for s in res.get("skipped") or []:
            if s.get("reason") == "the primary checkout":
                continue
            print("kept  %s  %s" % (s.get("path"), s.get("reason")))
        print(res.get("summary") or "")
    if failed:
        sys.exit(1)


# ---------- route / whoami ----------

def cmd_route(args):
    sub = args[0] if args else ""
    if sub == "list":
        r = get("/api/cli/route")
        for p in r.get("panes") or []:
            print("%s  %-18s %-24s %-12s %s" % (p.get("pane_id", ""), p.get("name", ""), p.get("target", ""),
                                                p.get("command", ""), p.get("topic", "")))
        if not r.get("panes"):
            print("no named panes")
    elif sub == "send":
        if len(args) < 3:
            die("usage: loom route send <name> <text...>", 2)
        try:
            r = c.http("POST", "/api/cli/route/send",
                       {"to": args[1], "text": " ".join(args[2:]), "pane": os.environ.get("TMUX_PANE", ""),
                        "session": c.session_id()}, timeout=10.0)
        except c.LoomUnavailable as e:
            die("Loom is not reachable (%s). Is it running?" % e, 3)
        except c.LoomError as e:
            die(str(e), 4)
        print(r.get("detail") or "delivered")
    else:
        die("usage: loom route list | send <name> <text...>", 2)


def cmd_whoami(_args):
    r = get("/api/cli/whoami?pane=%s&session=%s" % (os.environ.get("TMUX_PANE", ""), c.session_id()))
    for k in ("name", "pane_id", "session", "project"):
        print("%s: %s" % (k, r.get(k) or ""))


COMMANDS = {
    "outbox": cmd_outbox, "thread": cmd_thread, "ship-label": cmd_ship_label, "ship-lock": cmd_ship_lock,
    "route": cmd_route, "whoami": cmd_whoami, "test-links": cmd_test_links, "trees": cmd_trees,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0 if argv else 2
    fn = COMMANDS.get(argv[0])
    if not fn:
        die("unknown command %r (see loom --help)" % argv[0], 2)
    fn(argv[1:])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
