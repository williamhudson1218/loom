{
  "name": "loom-app",
  "version": "0.1.0",
  "private": true,
  "description": "Loom desktop app",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "rebuild": "electron-rebuild -f -w better-sqlite3,node-pty",
    "start": "yarn build && electron .",
    "dist": "yarn build && electron-builder"
  },
  "build": {
    "appId": "com.loom.app",
    "productName": "Loom",
    "directories": { "output": "release" },
    "files": ["dist/**", "node_modules/**", "package.json"],
    "asarUnpack": ["**/node_modules/better-sqlite3/**", "**/node_modules/node-pty/**", "dist/orchmcp.js"],
    "extraResources": [
      { "from": "build-plugin", "to": "plugin" }
    ],
    "extraFiles": [
      { "from": "build-native/ax/Loom.app", "to": "Helpers/ax/Loom.app" },
      { "from": "build-native/keychain/Loom.app", "to": "Helpers/keychain/Loom.app" }
    ],
    "afterPack": "./afterpack.cjs",
    "mac": {
      "target": "dir",
      "icon": "assets/icon.icns",
      "identity": null,
      "category": "public.app-category.developer-tools"
    },
    "npmRebuild": true
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0"
  }
}
